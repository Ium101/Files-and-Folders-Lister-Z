def _native_file_dialog(title, initialdir, filetypes):
    """kdialog (KDE) → zenity (GNOME) → tkinter fallback."""
    kde_filters = " | ".join(f"{lbl} ({pat})" for lbl, pat in filetypes)
    zenity_filters = []
    for _, pat in filetypes:
        for p in pat.split():
            zenity_filters += ["--file-filter", p]
    try:
        if subprocess.run(["which", "kdialog"], capture_output=True).returncode == 0:
            r = subprocess.run(
                ["kdialog", "--getopenfilename", str(initialdir), kde_filters, "--title", title],
                capture_output=True, text=True)
            if r.returncode == 0:
                p = r.stdout.strip()
                return p if p and os.path.isfile(p) else None
            return None
    except Exception:
        pass
    try:
        if subprocess.run(["which", "zenity"], capture_output=True).returncode == 0:
            r = subprocess.run(
                ["zenity", "--file-selection", "--title", title,
                 "--filename", str(initialdir) + "/"] + zenity_filters,
                capture_output=True, text=True)
            if r.returncode == 0:
                p = r.stdout.strip()
                return p if p and os.path.isfile(p) else None
            return None
    except Exception:
        pass
    from tkinter import filedialog as _fd
    p = _fd.askopenfilename(title=title, initialdir=str(initialdir), filetypes=filetypes)
    return p if p else None


def _native_dir_dialog(title, initialdir=""):
    """kdialog (KDE) → zenity (GNOME) → tkinter fallback."""
    start = str(initialdir) if initialdir else os.path.expanduser("~")
    try:
        if subprocess.run(["which", "kdialog"], capture_output=True).returncode == 0:
            r = subprocess.run(
                ["kdialog", "--getexistingdirectory", start, "--title", title],
                capture_output=True, text=True)
            if r.returncode == 0:
                selected = r.stdout.strip()
                return selected if selected and os.path.isdir(selected) else None
            return None
    except Exception:
        pass
    try:
        if subprocess.run(["which", "zenity"], capture_output=True).returncode == 0:
            r = subprocess.run(
                ["zenity", "--file-selection", "--directory",
                 "--title", title, "--filename", start + "/"],
                capture_output=True, text=True)
            if r.returncode == 0:
                p = r.stdout.strip()
                return p if p and os.path.isdir(p) else None
            return None
    except Exception:
        pass
    from tkinter import filedialog as _fd
    p = _fd.askdirectory(title=title, initialdir=start)
    return p if p else None


