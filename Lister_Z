# ── CREDITS FLAG ──────────────────────────────────────────────────────────────
# Set to True in lister_z_gui.py (the credits version); False here.
INCLUDE_CREDITS = True

def is_hidden_file(entry):
    hidden_names = {"desktop.ini", "thumbs.db", "._.ds_store", ".ds_store", ".gitignore", ".gitkeep"}
    if entry.name.startswith('.') or entry.name.lower() in hidden_names:
        return True
    try:
        import ctypes
        attrs = ctypes.windll.kernel32.GetFileAttributesW(str(entry.path))
        if attrs != -1 and attrs & 2:
            return True
    except Exception:
        pass
    return False

# ── APP DIRECTORY (works both frozen by PyInstaller and as plain .py) ────────
def _app_dir() -> str:
    """Return the folder that contains the exe (frozen) or the script (plain)."""
    import sys as _sys
    if getattr(_sys, "frozen", False):
        return os.path.dirname(_sys.executable)
    return os.path.dirname(os.path.abspath(__file__))


# ── RECENT FILES (plain text, one path per line) ──────────────────────────────
_MAX_RECENT = 20

def _recent_file_path() -> str:
    suffix = "windows" if os.name == "nt" else "linux"
    return os.path.join(_app_dir(), f"lister_z_recent_{suffix}.txt")


def _get_recent() -> list:
    try:
        with open(_recent_file_path(), "r", encoding="utf-8") as fh:
            paths = [line.strip() for line in fh if line.strip()]
        return [p for p in paths if os.path.isfile(p)]
    except Exception:
        return []


def _add_recent(path: str) -> None:
    existing = _get_recent()
    existing = [p for p in existing if p != path]
    existing.insert(0, path)
    existing = existing[:_MAX_RECENT]
    try:
        with open(_recent_file_path(), "w", encoding="utf-8") as fh:
            fh.write("\n".join(existing) + "\n")
    except Exception:
        pass


# ── SETTINGS (.ini) ───────────────────────────────────────────────────────────

def _settings_file_path() -> str:
    suffix = "windows" if os.name == "nt" else "linux"
    return os.path.join(_app_dir(), f"lister_z_settings_{suffix}.ini")


def _load_settings() -> configparser.ConfigParser:
    cfg = configparser.ConfigParser()
    cfg["settings"] = {"language": "en"}
    try:
        cfg.read(_settings_file_path(), encoding="utf-8")
    except Exception:
        pass
    return cfg


def _load_lang() -> str:
    return _load_settings().get("settings", "language", fallback="en")


def _save_lang(lang: str) -> None:
    cfg = _load_settings()
    cfg["settings"]["language"] = lang
    try:
        with open(_settings_file_path(), "w", encoding="utf-8") as fh:
            cfg.write(fh)
    except Exception:
        pass


# ── OPEN FILE ─────────────────────────────────────────────────────────────────

def _open_file(path):
    """Open path with the OS default application."""
    try:
        if os.name == "nt":
            os.startfile(path)
        else:
            subprocess.Popen(["xdg-open", path])
    except Exception as exc:
        messagebox.showerror("Error", str(exc))


# ── FILE LISTING ─────────────────────────────────────────────────────────────

def list_files_and_folders(directory, mode="B", list_option=1, recursive=True,
                            specific_subfolders=None, ignore_hidden=False,
                            L=None, parent=None, output_folder=None):
    import json as _json

    folder_name = os.path.basename(os.path.normpath(directory))
    disk_letter = os.path.splitdrive(os.path.abspath(directory))[0].replace(":", "")
    output_filename_base = f"{folder_name}{f' ({disk_letter})' if disk_letter else ''}"
    folders, files = [], []

    for entry in os.scandir(directory):
        if ignore_hidden and is_hidden_file(entry):
            continue
        if entry.is_dir():
            if not specific_subfolders or any(
                re.sub(r'\W+', '', sub).lower() in re.sub(r'\W+', '', entry.name).lower()
                for sub in specific_subfolders
            ):
                folders.append(entry.path)
        elif entry.is_file():
            files.append(entry.path)

    output_file_ext = 'docx' if mode.upper() == 'A' else ('json' if mode.upper() == 'C' else 'txt')
    save_location = output_folder if output_folder else directory
    output_file_path = os.path.join(save_location, f"{output_filename_base}.{output_file_ext}")

    credits_text = L["credits"] if INCLUDE_CREDITS else None

    if mode.upper() == "A":
        try:
            from docx import Document
            from docx.shared import Pt
            doc = Document()
            doc.add_heading(f"{folder_name}", level=1)

            if list_option in [1, 2]:
                for folder in folders:
                    write_folder_structure_docx(doc, folder, list_option=list_option, recursive=recursive)

            if list_option == 1:
                for file in files:
                    p = doc.add_paragraph("• ")
                    base, ext = os.path.splitext(os.path.basename(file))
                    p.add_run(base).italic = True
                    p.add_run(ext)

            if credits_text:
                p_credits = doc.add_paragraph()
                run = p_credits.add_run(credits_text)
                try:
                    run.font.size = Pt(8)
                except Exception:
                    pass

            doc.save(output_file_path)
            messagebox.showinfo(L["title"], L["success"].format(path=output_file_path), parent=parent)
        except Exception as e:
            messagebox.showerror(L["error"], L["docx_error"].format(err=e), parent=parent)
            return

    elif mode.upper() == "C":
        def folder_to_dict(path):
            d = {"folder": os.path.basename(path), "files": [], "subfolders": []}
            for entry in os.scandir(path):
                if entry.is_file():
                    d["files"].append(entry.name)
                elif entry.is_dir() and recursive:
                    d["subfolders"].append(folder_to_dict(entry.path))
            return d

        db = {
            "root": folder_name,
            "files": [os.path.basename(f) for f in files if list_option in [1, 3]],
            "folders": [folder_to_dict(f) for f in folders],
        }
        if credits_text:
            db["credits"] = credits_text

        with open(output_file_path, "w", encoding="utf-8") as json_file:
            _json.dump(db, json_file, indent=2, ensure_ascii=False)
        messagebox.showinfo(L["title"], L["json_success"].format(path=output_file_path), parent=parent)

    else:  # TXT
        with open(output_file_path, "w", encoding="utf-8") as txt_file:
            txt_file.write(f"{folder_name}\n\n")
            if list_option in [1, 2]:
                for folder in folders:
                    write_folder_structure_txt(txt_file, folder, list_option=list_option, recursive=recursive)
            if list_option in [1, 3]:
                for file in files:
                    txt_file.write(f"• {os.path.basename(file)}\n")
            if credits_text:
                txt_file.write(f"\n{credits_text}\n")
        messagebox.showinfo(L["title"], L["success"].format(path=output_file_path), parent=parent)

    # ── Save to recent list and auto-open ────────────────────────────────────
    _add_recent(output_file_path)
    _open_file(output_file_path)


def write_folder_structure_docx(doc, folder, indent=0, list_option=1, recursive=True):
    p = doc.add_paragraph("    " * indent + "• ")
    p.add_run(os.path.basename(folder)).bold = True
    entries = sorted(os.scandir(folder), key=lambda e: (not e.is_dir(), e.name.lower()))
    for entry in entries:
        if entry.is_dir() and recursive:
            write_folder_structure_docx(doc, entry.path, indent + 1, list_option, recursive)
        elif entry.is_file() and list_option == 1:
            sub_p = doc.add_paragraph("    " * (indent + 1))
            base, ext = os.path.splitext(entry.name)
            sub_p.add_run(base).italic = True
            sub_p.add_run(ext)

def write_folder_structure_txt(txt_file, folder, indent=0, list_option=1, recursive=True):
    txt_file.write(f"{'    ' * indent}• {os.path.basename(folder)}\n")
    entries = sorted(os.scandir(folder), key=lambda e: (not e.is_dir(), e.name.lower()))
    for entry in entries:
        if entry.is_dir() and recursive:
            write_folder_structure_txt(txt_file, entry.path, indent + 1, list_option, recursive)
        elif entry.is_file() and list_option == 1:
            txt_file.write(f"{'    ' * (indent + 1)}{os.path.basename(entry.name)}\n")

def create_folders_from_json_gui(root, lang_code):
    import json as _json
    L = LANGUAGES[lang_code]
    root.withdraw()
    while True:
        json_path = _native_file_dialog(L["select_json"], os.path.expanduser("~"), [("JSON files", "*.json")])
        if not json_path:
            root.deiconify()
            return
        try:
            with open(json_path, "r", encoding="utf-8") as f:
                data = _json.load(f)
            break
        except _json.JSONDecodeError:
            messagebox.showerror(L["error"], L["invalid_json_format"], parent=root)
        except Exception as e:
            messagebox.showerror(L["error"], f"{L['error_creating']}: {e}", parent=root)
            root.deiconify()
            return

    base_dir = _native_dir_dialog(L["select_base_dir"])
    if not base_dir:
        root.deiconify()
        return

    try:
        def create_structure(d, parent):
            folder_name = d.get("folder", d.get("root", ""))
            if folder_name:
                folder_path = os.path.join(parent, folder_name)
                os.makedirs(folder_path, exist_ok=True)
                for subfolder in d.get("subfolders", []):
                    create_structure(subfolder, folder_path)

        if "root" in data:
            create_structure({"folder": data["root"], "subfolders": data.get("folders", [])}, base_dir)
        else:
            create_structure(data, base_dir)

        messagebox.showinfo(L["title"], L["folders_created"], parent=root)
    except Exception as e:
        messagebox.showerror(L["error"], f"{L['error_creating']}: {e}", parent=root)

    root.deiconify()

def run_lister(root, lang_code):
    L = LANGUAGES[lang_code]
    root.withdraw()
    directory = _native_dir_dialog(L["select_dir"])
    if not directory:
        root.deiconify()
        return

    output_folder = _native_dir_dialog(L["select_output_dir"])
    if not output_folder:
        root.deiconify()
        return

    mode = simpledialog.askstring(L["title"], L["mode"], parent=root)
    if mode is None:
        root.deiconify()
        return
    mode = mode.strip().lower()
    if mode in ["a", "docx"]:
        mode = "A"
    elif mode in ["b", "txt"]:
        mode = "B"
    elif mode in ["c", "json"]:
        mode = "C"
    else:
        messagebox.showerror(L["title"], L["invalid_mode"], parent=root)
        root.deiconify()
        return

    list_option = simpledialog.askinteger(L["title"], L["list_option"], minvalue=1, maxvalue=3, parent=root)
    if list_option is None:
        root.deiconify()
        return

    filter_input = simpledialog.askstring(L["title"], L["filter"], parent=root)
    if filter_input is None:
        root.deiconify()
        return
    specific_subfolders = [f.strip() for f in filter_input.split(",")] if filter_input else None

    include_subfolders = messagebox.askyesno(L["title"], L["include_subfolders"], parent=root)
    ignore_hidden = messagebox.askyesno(L["title"], L["hide_hidden"], parent=root)
    list_files_and_folders(
        directory, mode=mode, list_option=list_option, recursive=include_subfolders,
        specific_subfolders=specific_subfolders, ignore_hidden=ignore_hidden,
        L=L, parent=root, output_folder=output_folder
    )
    root.deiconify()


def open_recent_gui(root, lang_code):
    L = LANGUAGES[lang_code]

    recent_files = _get_recent()

    if not recent_files:
        messagebox.showinfo(L["title"], L["no_recent_files"], parent=root)
        return

    from tkinter import Toplevel, Listbox, Scrollbar, END, SINGLE

    win = Toplevel(root)
    win.title(L["recent_title"])
    win.geometry("620x320")
    win.resizable(True, True)
    win.grab_set()
    win.configure(bg="white")

    frame = tk.Frame(win, bg="white")
    frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

    sb = Scrollbar(frame)
    sb.pack(side=tk.RIGHT, fill=tk.Y)

    lb = Listbox(
        frame,
        yscrollcommand=sb.set,
        selectmode=SINGLE,
        font=("Segoe UI", 10) if os.name == "nt" else ("DejaVu Sans", 10),
        activestyle="dotbox",
        bd=0,
        highlightthickness=1,
    )
    lb.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)
    sb.config(command=lb.yview)

    for path in recent_files:
        lb.insert(END, path)

    lb.selection_set(0)
    lb.activate(0)

    def _open():
        sel = lb.curselection()
        if not sel:
            return
        path = recent_files[sel[0]]
        if not os.path.isfile(path):
            messagebox.showerror(
                L["error"],
                L["error_dir"].format(directory=path),
                parent=win,
            )
            return
        _open_file(path)
        win.destroy()

    lb.bind("<Double-Button-1>", lambda e: _open())
    lb.bind("<Return>", lambda e: _open())

    btn_frame = tk.Frame(win, bg="white")
    btn_frame.pack(fill=tk.X, padx=10, pady=(0, 10))

    tk.Button(
        btn_frame,
        text=L["open_btn"],
        command=_open,
        bg="#3498db",
        fg="white",
        activebackground="#2980b9",
        relief=tk.FLAT,
        bd=0,
        padx=18,
        pady=6,
        cursor="hand2",
        font=("Segoe UI", 10) if os.name == "nt" else ("DejaVu Sans", 10),
    ).pack(side=tk.RIGHT)

    win.wait_window()


def run_gui():
    root = tk.Tk()
    root.title("Lister Z")
    root.geometry("595x430")
    root.configure(bg="white")
    root.resizable(False, False)

    try:
        dpi = root.winfo_fpixels("1i")
        scale = dpi / 96.0
    except Exception:
        scale = 1.0

    _FONT        = "Segoe UI" if os.name == "nt" else "DejaVu Sans"
    button_font  = (_FONT, int(11 * scale))
    toggle_font  = (_FONT, int(10 * scale), "bold")
    title_font   = (_FONT, int(16 * scale))

    lang_var = tk.StringVar(value=_load_lang())

    # ── Header ────────────────────────────────────────────────────────────────
    header = tk.Frame(root, bg="#2c3e50", height=int(48 * scale))
    header.pack(fill=tk.X, side=tk.TOP)
    header.pack_propagate(False)

    tk.Label(
        header, text="Lister Z",
        bg="#2c3e50", fg="white",
        font=title_font, anchor="w",
    ).pack(side=tk.LEFT, padx=14)

    content_frame = tk.Frame(root, bg="white")
    content_frame.pack(fill=tk.BOTH, expand=True, padx=0, pady=0)

    create_list_var   = tk.StringVar()
    create_folder_var = tk.StringVar()
    open_recent_var   = tk.StringVar()

    _TOGGLE_COLORS = {
        "pt": ("#27ae60", "#219a52"),
        "en": ("#e74c3c", "#c0392b"),
    }
    _TOGGLE_LABELS = {
        "pt": "PT-BR",
        "en": "EN-US",
    }

    toggle_btn = tk.Button(
        content_frame,
        text="",
        height=2,
        font=toggle_font,
        fg="white",
        relief=tk.FLAT, bd=0,
        cursor="hand2",
    )
    toggle_btn.pack(fill=tk.X, padx=0, pady=0)

    def _toggle_language():
        new_lang = "pt" if lang_var.get() == "en" else "en"
        lang_var.set(new_lang)
        _save_lang(new_lang)
        _refresh_ui()

    toggle_btn.config(command=_toggle_language)

    def _make_btn(text_var, color, active_color, command):
        btn = tk.Button(
            content_frame,
            textvariable=text_var,
            command=command,
            height=3,
            font=button_font,
            bg=color, fg="white",
            activebackground=active_color,
            relief=tk.FLAT, bd=0,
            cursor="hand2",
        )
        btn.pack(fill=tk.X, padx=0, pady=0)
        return btn

    _make_btn(create_list_var,   "#3498db", "#2980b9", lambda: run_lister(root, lang_var.get()))
    _make_btn(create_folder_var, "#27ae60", "#229954", lambda: create_folders_from_json_gui(root, lang_var.get()))
    _make_btn(open_recent_var,   "#9b59b6", "#8e44ad", lambda: open_recent_gui(root, lang_var.get()))

    # ── Credits bar (visible only in credits build) ───────────────────────────
    if INCLUDE_CREDITS:
        credits_frame = tk.Frame(root, bg="#f5f5f5", height=int(50 * scale))
        credits_frame.pack(side=tk.BOTTOM, fill=tk.X)
        credits_frame.pack_propagate(False)
        credits_lbl = tk.Label(
            credits_frame, text="",
            font=(_FONT, int(8 * scale)), bg="#f5f5f5", fg="#999999",
        )
        credits_lbl.pack(pady=int(8 * scale))
    else:
        credits_lbl = None

    def _refresh_ui():
        lc = lang_var.get()
        L  = LANGUAGES[lc]
        create_list_var.set(L["create_list"])
        create_folder_var.set(L["create_folders"])
        open_recent_var.set(L["open_recent"])
        if credits_lbl:
            credits_lbl.config(text=L["credits"])
        bg, abg = _TOGGLE_COLORS[lc]
        toggle_btn.config(
            text=_TOGGLE_LABELS[lc],
            bg=bg,
            activebackground=abg,
        )

    _refresh_ui()
    root.mainloop()

# ── EMBEDDED ICON BUILDER ─────────────────────────────────────────────────────

def _build_ico(out_path: str) -> None:
    """Generate a crisp multi-resolution .ico using Pillow."""
    from PIL import Image, ImageDraw

    BLUE = (52, 152, 219, 255)
    SUPERSAMPLE = 1024
    ICO_SIZES = [16, 24, 32, 48, 64, 128, 256]

    def _draw(size: int) -> "Image.Image":
        img = Image.new("RGBA", (size, size), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)
        s = size / 100.0
        stroke_w = max(1, round(6 * s))
        r = stroke_w / 2

        def pt(x, y):
            return (x * s, y * s)

        outline = [
            pt(5, 20), pt(5, 85),
            pt(5.5, 88.5), pt(7, 90), pt(10, 90),
            pt(90, 90), pt(93, 90), pt(95, 88.5), pt(95, 85),
            pt(95, 35), pt(95, 32), pt(93, 30), pt(90, 30),
            pt(50, 30), pt(40, 20), pt(5, 20),
        ]
        draw.line(outline, fill=BLUE, width=stroke_w, joint="curve")
        for x, y in outline:
            draw.ellipse([x - r, y - r, x + r, y + r], fill=BLUE)

        def rline(x1, y1, x2, y2):
            p1, p2 = pt(x1, y1), pt(x2, y2)
            draw.line([p1, p2], fill=BLUE, width=stroke_w)
            for x, y in (p1, p2):
                draw.ellipse([x - r, y - r, x + r, y + r], fill=BLUE)

        rline(22, 52, 78, 52)
        rline(22, 65, 78, 65)
        rline(22, 78, 60, 78)
        return img

    base = _draw(SUPERSAMPLE)
    frames = [base.resize((sz, sz), Image.LANCZOS) for sz in ICO_SIZES]
    frames[-1].save(out_path, format="ICO", sizes=[(f.width, f.height) for f in frames])
    print(f"[OK] Wrote {out_path} ({', '.join(str(s) for s in ICO_SIZES)}px)")


if __name__ == "__main__":
    import sys as _sys
    if len(_sys.argv) == 3 and _sys.argv[1] == "--make-icon":
        _build_ico(_sys.argv[2])
    else:
        run_gui()
